# =========================================================================
# SERVER-SIDE CONTACT FORM EMAIL CONFIGURATION (RESEND)
# =========================================================================

# 1. Create a free account at https://resend.com (3,000 emails/month free)
# 2. Go to API Keys -> Create API Key (Sending access) and paste below:
RESEND_API_KEY=re_your_resend_api_key_here

# Email address that receives portfolio contact inquiries:
CONTACT_RECEIVER_EMAIL=dasunmethmal23@gmail.com

# Optional: Custom verified sender after verifying your domain in Resend
# (Defaults to "Dasun Methmal Portfolio <onboarding@resend.dev>" if omitted)
# RESEND_FROM_EMAIL="Dasun Methmal Portfolio <contact@dasunmethmal.com>"

# =========================================================================
# OPTIONAL FALLBACK: GMAIL SMTP (only needed if you want a secondary backup)
# =========================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
